{
  "version": 1,
  "author": "Smart Soil Nutrition Project",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-potentiometer",
      "id": "pot1",
      "top": -90,
      "left": 160,
      "attrs": { "label": "Cam Bien Nuoc (ADC GPIO34)" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": 160,
      "left": 160,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 160,
      "left": -120,
      "attrs": { "color": "green", "label": "Trang thai" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "pot1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "pot1:SIG", "esp:34", "green", [ "v0" ] ],

    [ "oled1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "oled1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled1:SDA", "esp:21", "blue", [ "v0" ] ],
    [ "oled1:SCL", "esp:22", "yellow", [ "v0" ] ],

    [ "led1:A", "esp:33", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
